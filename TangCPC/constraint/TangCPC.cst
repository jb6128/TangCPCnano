// TangCPC.cst — Contraintes de placement des pins
// Tang Nano 20K (GW2AR-18C, boîtier QN88)
// Copié depuis MiSTeryNano atarist.cst — pins identiques

// Horloge 27 MHz
IO_LOC "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// UART BL616 intégré
IO_LOC "uart_rx" 70;
IO_PORT "uart_rx" PULL_MODE=UP IO_TYPE=LVCMOS33 BANK_VCCIO=3.3;

// Console BL616 (pour adaptateur USB-UART externe)
IO_LOC "bl616_mon_tx" 48;
IO_PORT "bl616_mon_tx" DRIVE=8 IO_TYPE=LVCMOS33 BANK_VCCIO=3.3;
IO_LOC "bl616_mon_rx" 55;
IO_PORT "bl616_mon_rx" PULL_MODE=UP IO_TYPE=LVCMOS33 BANK_VCCIO=3.3;

// Sortie vidéo HDMI (TMDS différentiel)
IO_LOC "tmds_clk_p" 33,34;
IO_PORT "tmds_clk_p" PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_p[0]" 35,36;
IO_PORT "tmds_d_p[0]" PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_p[1]" 37,38;
IO_PORT "tmds_d_p[1]" PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_p[2]" 39,40;
IO_PORT "tmds_d_p[2]" PULL_MODE=NONE DRIVE=8;

// LEDs intégrées (actif bas)
IO_LOC "leds_n[5]" 20;
IO_PORT "leds_n[5]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "leds_n[4]" 19;
IO_PORT "leds_n[4]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "leds_n[3]" 18;
IO_PORT "leds_n[3]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "leds_n[2]" 17;
IO_PORT "leds_n[2]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "leds_n[1]" 16;
IO_PORT "leds_n[1]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "leds_n[0]" 15;
IO_PORT "leds_n[0]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;

// LED RGB WS2812
IO_LOC "ws2812" 79;
IO_PORT "ws2812" DRIVE=8 IO_TYPE=LVCMOS33;

// Flash SPI
IO_LOC "mspi_wp" 57;
IO_PORT "mspi_wp" PULL_MODE=DOWN IO_TYPE=LVCMOS33;
IO_LOC "mspi_clk" 59;
IO_PORT "mspi_clk" PULL_MODE=NONE DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "mspi_cs" 60;
IO_PORT "mspi_cs" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "mspi_di" 61;
IO_PORT "mspi_di" PULL_MODE=NONE DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "mspi_do" 62;
IO_PORT "mspi_do" PULL_MODE=NONE DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "mspi_hold" 63;
IO_PORT "mspi_hold" PULL_MODE=NONE IO_TYPE=LVCMOS33;

// Carte SD
IO_LOC "sd_clk" 83;
IO_PORT "sd_clk" PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_LOC "sd_cmd" 82;
IO_PORT "sd_cmd" PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_LOC "sd_dat[0]" 84;
IO_PORT "sd_dat[0]" PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_LOC "sd_dat[1]" 85;
IO_PORT "sd_dat[1]" PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_LOC "sd_dat[2]" 80;
IO_PORT "sd_dat[2]" PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_LOC "sd_dat[3]" 81;
IO_PORT "sd_dat[3]" PULL_MODE=NONE IO_TYPE=LVCMOS33;

// GPIO — joystick DB9 / souris (port 1)
// Pins 25-30 : GPIO externes 3.3V — LVCMOS33 requis (ELVDS HDMI force vérification stricte)
IO_LOC "io[0]" 27;
IO_PORT "io[0]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "io[1]" 28;
IO_PORT "io[1]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "io[2]" 25;
IO_PORT "io[2]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "io[3]" 26;
IO_PORT "io[3]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "io[4]" 29;
IO_PORT "io[4]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "io[5]" 30;
IO_PORT "io[5]" PULL_MODE=UP IO_TYPE=LVCMOS33;

// GPIO spare — joystick DB9 port 2
IO_LOC "spare[0]" 73;
IO_PORT "spare[0]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "spare[1]" 74;
IO_PORT "spare[1]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "spare[2]" 77;
IO_PORT "spare[2]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "spare[3]" 31;
IO_PORT "spare[3]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "spare[4]" 49;
IO_PORT "spare[4]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "spare[5]" 52;
IO_PORT "spare[5]" PULL_MODE=UP IO_TYPE=LVCMOS33;

// Interface MCU externe M0S Dock
// Pins 41-42 : GPIO externes 3.3V — LVCMOS33 requis
IO_LOC "m0s_0" 42;
IO_PORT "m0s_0" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "m0s_1" 41;
IO_PORT "m0s_1" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "m0s_2" 56;
IO_PORT "m0s_2" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "m0s_3" 54;
IO_PORT "m0s_3" PULL_MODE=UP IO_TYPE=LVCMOS33;
// m0s_4 (pin 51) : retiré Phase 0, à rajouter Phase 6

// SPI vers BL616 intégré
IO_LOC "spi_csn" 86;
IO_PORT "spi_csn" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "spi_sclk" 13;
IO_PORT "spi_sclk" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "spi_dat" 76;
IO_PORT "spi_dat" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "spi_dir" 75;
IO_PORT "spi_dir" PULL_MODE=NONE DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "spi_irqn" 69;
IO_PORT "spi_irqn" PULL_MODE=NONE DRIVE=8 IO_TYPE=LVCMOS33;

// Boutons
IO_LOC "user" 88;
IO_PORT "user" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "reset" 87;
IO_PORT "reset" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
